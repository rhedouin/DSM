// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".",
        "args": {
            "USERNAME": "${localEnv:USER}"
        }
        // If you need additional build arguments, you can specify them here:
        // "args": {
        //     "VAR_NAME": "value"
        // }
    },
    "remoteUser": "renaud",
    "containerUser": "renaud",

    // "remoteUser": "erwan",
    "mounts": [
        "source=/data,target=/data,type=bind",
        "source=/home,target=/home,type=bind",
        "source=/data/fast/tmp/${localEnv:USER},target=/content/data,type=bind"
    ],
    "runArgs": [
        "--gpus=all",
        "--shm-size=50gb",
        "--memory=200g",
        "--memory-swap=400g"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-azuretools.vscode-docker",
                "GitHub.copilot",
                "GitHub.copilot-chat",
                "ms-toolsai.jupyter",
                "ms-toolsai.vscode-jupyter-cell-tags",
                "ms-toolsai.jupyter-renderers",
                "ms-toolsai.vscode-jupyter-slideshow",
                "ms-toolsai.tensorboard"
            ]
        }
    },
    "postCreateCommand": "" 
    // pip3 install wget geopandas geemap xarray[complete] wxee rioxarray rhealpixdggs DGGSForPoly fiona exactextract contextily climada pathos==0.3.0 multiprocess==0.70.15 xgboost"
}
